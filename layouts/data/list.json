{{- $pages := where .Site.RegularPages "Section" "in" (slice "news" "cases" "products" "markets" "suppliers") -}}
{{- $sorted := sort $pages "Date" "desc" -}}
{{- $.Scratch.Set "items" (slice) -}}
{{- range $sorted -}}
  {{- $section := .Section -}}
  {{- if eq $section "" -}}
    {{- $section = .Type -}}
  {{- end -}}
  {{- $.Scratch.Add "items" (dict
      "title" .Title
      "section" $section
      "uri" .RelPermalink
      "date" (printf "%s" .Date)
      "params" (.Params | default dict)
  ) -}}
{{- end -}}
{{- $items := $.Scratch.Get "items" -}}
{{- jsonify (dict
    "generatedAt" (now)
    "total" (len $items)
    "items" $items
) -}}
