############################################################
# Local development env for Netlify Functions (do not commit secrets)
# Copy to `.env` and fill values, then run `netlify dev`
############################################################

# Airtable access token (personal access token or legacy API key)
# Example: patXXXXXXXXXXXX or keyXXXXXXXXXXXX
AIRTABLE_API_KEY=

# Airtable Base ID (starts with "app", from the base URL or API docs)
# Example: appXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=

# Optional: table names (override if you use custom names)
AIRTABLE_REQUIREMENTS_TABLE=Requirements
AIRTABLE_QUOTES_TABLE=RequirementQuotes

# Backward-compatible legacy names (not recommended, but supported)
# If you prefer legacy naming, you can set these instead of the ones above
AIRTABLE_KEY=
AIRTABLE_BASE=

# Admin & quoting options
# ADMIN_KEY is required to access the management page functions
# REQUIRE_QUOTE_PASSWORD controls whether suppliers must pass view password to submit quotes
ADMIN_KEY=
REQUIRE_QUOTE_PASSWORD=true
AIRTABLE_AUDIT_TABLE=AuditLogs

# Hugo dev options (optional)
# HUGO_ENV=development

############################################################
# Optional: Global supplier password & SystemConfig fallbacks
############################################################

# Global supplier password (either plain or bcrypt hash). If both are set,
# the hash takes precedence.
SUPPLIER_GLOBAL_PASSWORD=
SUPPLIER_GLOBAL_PASSWORD_HASH=

# Optional: use environment fallbacks for notifications when SystemConfig
# does not define them.
NOTIFY_ON_PUBLISH_EMAIL=false
NOTIFY_ON_PUBLISH_SMS=false

# Optional: Airtable SystemConfig table name override
AIRTABLE_SYSTEM_TABLE=SystemConfig
