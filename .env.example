############################################################
# Local development env for Netlify Functions (do not commit secrets)
# Copy to `.env` and fill values, then run `netlify dev`
############################################################

# Airtable access token (personal access token or legacy API key)
# Example: patXXXXXXXXXXXX or keyXXXXXXXXXXXX
AIRTABLE_API_KEY=

# Airtable Base ID (starts with "app", from the base URL or API docs)
# Example: appXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=

# Optional: table names (override if you use custom names)
AIRTABLE_REQUIREMENTS_TABLE=Requirements
AIRTABLE_QUOTES_TABLE=RequirementQuotes

# Backward-compatible legacy names (not recommended, but supported)
# If you prefer legacy naming, you can set these instead of the ones above
AIRTABLE_KEY=
AIRTABLE_BASE=

# Hugo dev options (optional)
# HUGO_ENV=development
